# Dolby Management Service (vendor.dolby.hardware.dms@2.0)
# Generic policy for the DMS HIDL daemon + its IDms hwservice.
# The DAP effect lib (libswdap.so) loaded into audioserver reaches this
# daemon via hwbinder; mediacodec and the controller app also query it.

attribute hal_dms;
attribute hal_dms_client;
attribute hal_dms_server;

type hal_dms_hwservice, hwservice_manager_type;

type hal_dms_default, domain;
type hal_dms_default_exec, exec_type, vendor_file_type, file_type;

hal_server_domain(hal_dms_default, hal_dms)
init_daemon_domain(hal_dms_default)

# DMS daemon: load its vendor shared libraries (engine blobs + the libsqlite ->
# libandroidicu -> libicuuc/libicui18n chain vendored for the A16 namespace).
allow hal_dms_default vendor_file_type:file { read execute getattr map open };
allow hal_dms_default vendor_file_type:dir { search read open getattr };

# HwBinder IPC between clients and the DMS daemon, plus callback path
binder_call(hal_dms_client, hal_dms_server)
binder_call(hal_dms_server, hal_dms_client)
add_hwservice(hal_dms_server, hal_dms_hwservice)
allow hal_dms_client hal_dms_hwservice:hwservice_manager find;

# DMS daemon: store/read Dolby params under /data/vendor/dolby
allow hal_dms_default vendor_data_file:file { rw_file_perms create unlink };
allow hal_dms_default vendor_data_file:dir { rw_file_perms add_name remove_name };

# DMS daemon: property socket + comms with media/audio/controller app
allow hal_dms_default property_socket:sock_file write;
allow hal_dms_default mediacodec:binder call;
binder_call(hal_dms_default, hal_audio_default)
binder_call(hal_dms_default, platform_app)

# Clients allowed to find and call the DMS service
allow hal_audio_default hal_dms_hwservice:hwservice_manager find;
binder_call(hal_audio_default, hal_dms_default)

allow mediacodec hal_dms_hwservice:hwservice_manager find;
binder_call(mediacodec, hal_dms_default)

allow platform_app hal_dms_hwservice:hwservice_manager find;
binder_call(platform_app, hal_dms_default)
