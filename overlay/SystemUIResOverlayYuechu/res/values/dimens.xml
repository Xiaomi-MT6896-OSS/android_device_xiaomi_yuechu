<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <dimen name="status_bar_clock_end_padding">6dp</dimen>
    <dimen name="status_bar_padding_start">0dp</dimen>
    <dimen name="rounded_corner_content_padding">61.0px</dimen>
    <dimen name="physical_fingerprint_sensor_center_screen_location_x">1080px</dimen>
    <dimen name="physical_fingerprint_sensor_center_screen_location_y">@dimen/physical_power_button_center_screen_location_y</dimen>
    <dimen name="physical_power_button_center_screen_location_y">1060px</dimen>

    <!-- UDFPS icon pixel pitch (micrometers/pixel). Framework default is -1, which makes
         iconSize = udfps_icon_size / pixel_pitch negative and renders the fingerprint
         affordance distorted. 25400 / physical ppi 401.898 = 63.2. -->
    <item name="pixel_pitch" format="float" type="dimen">63.2</item>

    <!-- Push keyguard indication (charging/alarm/owner text) above the FOD circle
         (whose top edge sits ~121dp from the bottom of a 2400px / 440dpi screen). -->
    <dimen name="keyguard_indication_margin_bottom">130dp</dimen>
</resources>
